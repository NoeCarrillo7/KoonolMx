---
import logo from "../../assets/nav/logo.png";
const pathname = Astro.url.pathname;
const active = "bg-principal text-white";
const inactive = "hover:bg-principal hover:text-white transition";
---

<section class="fixed top-0 left-0 w-full z-50 flex justify-center">
  <div class="w-[95%] lg:w-5/6">
    <div class="flex items-center justify-between">

      <button id="menuButton" class="relative z-50">
        <img
          src={logo.src}
          alt="Koonol"
          class="h-30 md:h-24 lg:h-[160px] w-auto"
        />
      </button>

      <!-- Desktop -->

      <div class="hidden md:flex items-center gap-70">
        <nav
          class="flex items-center gap-2 bg-white rounded-full shadow-md p-2"
        >
          <a
            href="/"
            class:list={[
              "px-5 lg:px-6 py-3 rounded-full font-medium",

              pathname === "/" ? active : inactive,
            ]}
          >
            Inicio
          </a>

          <a
            href="/productos/telecomunicaciones"
            class:list={[
              "px-5 lg:px-6 py-3 rounded-full font-medium",

              pathname.startsWith("/productos") ? active : inactive,
            ]}
          >
            Productos
          </a>

          <a
            href="#nosotros"
            class:list={[
              "px-5 lg:px-6 py-3 rounded-full font-medium",

              pathname === "/nosotros" ? active : inactive,
            ]}
          >
            Nosotros
          </a>
        </nav>

        <a
          href="/#contacto"
          class="bg-[#025971] text-white px-6 lg:px-8 py-3 lg:py-4 rounded-full hover:scale-105 transition"
        >
          Contacto
        </a>
      </div>
    </div>

    <!-- Menú móvil -->

    <div
      id="mobileMenu"
      class="fixed top-0 left-0 w-full h-screen bg-white z-40
         flex flex-col justify-center items-center
         translate-y-[-100%] opacity-0
         transition-all duration-500 ease-in-out md:hidden"
    >
      <nav class="flex flex-col items-center gap-8">
        <a href="/" class="text-2xl font-medium hover:text-[#025971]">
          Inicio
        </a>

        <a
          href="/productos/telecomunicaciones"
          class="text-2xl font-medium hover:text-[#025971]"
        >
          Productos
        </a>

        <a href="/#nosotros" class="text-2xl font-medium hover:text-[#025971]">
          Nosotros
        </a>

        <a
          href="/#contacto"
          class="bg-[#025971] text-white px-10 py-4 rounded-full text-xl"
        >
          Contacto
        </a>
      </nav>
    </div>
  </div>
</section>

<script>
  const button = document.getElementById("menuButton");

  const menu = document.getElementById("mobileMenu");

  if (button instanceof HTMLButtonElement && menu instanceof HTMLDivElement) {
    let open = false;

    button.addEventListener("click", () => {
      open = !open;

      if (open) {
        menu.classList.remove("translate-y-[-100%]", "opacity-0");

        menu.classList.add("translate-y-0", "opacity-100");

        document.body.style.overflow = "hidden";
      } else {
        menu.classList.remove("translate-y-0", "opacity-100");

        menu.classList.add("translate-y-[-100%]", "opacity-0");

        document.body.style.overflow = "";
      }
    });
  }
</script>
