---
import logo from "../../assets/footer/logoblanco.png";
import logohbl from "../../assets/footer/logoHBLmorado.png";
---

<section class="bg-[#025971] text-white w-full">
	<div class="max-w-7xl mx-auto px-8 py-16">
		<div class="grid grid-cols-1 md:grid-cols-4 gap-12">
			<div class="flex justify-center md:justify-start">
				<img src={logo.src} alt="Koonol MX" class="h-40 w-60 mb-5" />
			</div>
			<!-- Links -->
			<div class=" animar fadeUp text-center md:text-start">
				<h3 class=" animar fadeLeft font-bold text-lg mb-6 uppercase tracking-wider">
					Links
				</h3>
				<ul class="space-y-3 text-sm">
					<li><a href="/" class="hover:text-gray-300">Inicio</a></li>
					<li>
						<a href="/nosotros" class="hover:text-gray-300"
							>Nosotros</a
						>
					</li>
					<li>
						<a href="/productos" class="hover:text-gray-300"
							>Productos</a
						>
					</li>
					<li>
						<a href="/contacto" class="hover:text-gray-300"
							>Contacto</a
						>
					</li>
				</ul>
			</div>

			<div class="animar fadeUp flex flex-col items-center md:items-start">
				<h3 class="animar fadeLeft font-bold text-lg mb-0 uppercase tracking-wider">
					Social
				</h3>
				<div class="flex gap-8 pt-5">
					<a>
						<i class="fa-brands fa-facebook-f text-2xl"></i>
					</a>
					<a>
						<i class="fa-brands fa-whatsapp text-2xl"></i>
					</a>
					<a>
						<i class="fa-brands fa-instagram text-2xl"></i>
					</a>
				</div>
			</div>

			<div class="flex flex-col items-center md:items-start">
				<h3 class="animar fadeLeft font-bold text-lg mb-6 uppercase tracking-wider">
					Contacto
				</h3>

        <div class="animar fadeUp space-y-5 text-sm">

          <div class="flex items-start justify-center sm:justify-start gap-3">
            <i class="fa-solid fa-phone mt-1 text-lg shrink-0"></i>
            <p>+52 442 454 0557</p>
          </div>

          <div class="flex items-start justify-center sm:justify-start gap-3">
            <i class="fa-regular fa-envelope mt-1 text-lg shrink-0"></i>
            <p class="break-all sm:break-normal">
              contacto@koonol.com.mx
            </p>
          </div>

          <div class="flex items-start justify-center sm:justify-start gap-3">
            <i class="fa-solid fa-location-dot mt-1 text-lg shrink-0"></i>

            <p class="leading-relaxed">
              C. Armando Birlain Shafler 2001<br> 
              Centro Sur, 76090<br>
              Santiago de Querétaro, Qro.
            </p>
          </div>

        </div>
      </div>

    </div>

    <!-- Copyright -->
    <div class="border-t border-white/20 mt-12 lg:mt-14 pt-6 lg:pt-8">
      <p class="animar slideBottom text-center text-white/60 text-xs sm:text-sm leading-relaxed">
        © Copyright 2026 Koonol MX | Todos los Derechos Reservados.
      </p>
    </div>

  </div>

  <!-- Barra HBL -->
  <div class="bg-white py-4">
    <div class="animar fadeUp max-w-7xl mx-auto px-6 flex flex-col sm:flex-row justify-center items-center gap-2 sm:gap-3 text-sm text-gray-600 text-center"
    >

      <span>Diseño y desarrollo web</span>

      <img
        src={logohbl.src}
        alt="HBL MORADO"
        class="h-7 sm:h-8 w-auto object-contain"
      />

    </div>
  </div>
</section>