---
interface Product {
  tag: string;
  title: string;
  description: string;
  images: string[];
}

interface Props {
  left?: Product;
  right?: Product;
}

const { left, right } = Astro.props;
---

<div class="bg-white rounded-xl p-6 border border-slate-100 shadow-xl flex flex-col md:flex-row justify-between gap-6">
    {left && (
        <div class="flex-1">
            <div class="text-center mb-4">
                <span class="text-xs font-semibold text-[#004B6E] uppercase tracking-wider">{left.tag}</span>
                <h3 class="text-lg font-bold text-slate-800">{left.title}</h3>
            </div>

            <div class={`my-4 ${left.images.length > 1 ? 'grid grid-cols-2 gap-4 items-center justify-items-center' : 'flex justify-center'}`}>
                {left.images.map((imgUrl, index) => (
                    <img 
                        src={imgUrl} 
                        alt={`${left.title} - Vista ${index + 1}`} 
                        class="max-h-36 object-contain w-auto"
                    />
                ))}
            </div>

            <p class="text-xs text-slate-500 text-center leading-relaxed mt-2">
                {left.description}
            </p>
        </div>
    )}

    {right && (
        <div class="flex-1">
            <div class="text-center mb-4">
                <span class="text-xs font-semibold text-[#004B6E] uppercase tracking-wider">{right.tag}</span>
                <h3 class="text-lg font-bold text-slate-800">{right.title}</h3>
            </div>

            <div class={`my-4 ${right.images.length > 1 ? 'grid grid-cols-2 gap-4 items-center justify-items-center' : 'flex justify-center'}`}>
                {right.images.map((imgUrl, index) => (
                    <img 
                        src={imgUrl} 
                        alt={`${right.title} - Vista ${index + 1}`} 
                        class="max-h-36 object-contain w-auto"
                    />
                ))}
            </div>

            <p class="text-xs text-slate-500 text-center leading-relaxed mt-2">
                {right.description}
            </p>
        </div>
    )}
</div>