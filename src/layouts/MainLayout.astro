---
import '../styles/global.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
    <head>
        <title>KoonolMX</title>
        <meta name="description" content="Comercializadora especializada en los sectores de transformación, refrigeración, automatización y conectividad." />

        <meta property="og:type" content="website" />
        <meta property="og:url" content="https://koonolmex.com.mx/" />
        <meta property="og:title" content="KoonolMX" />
        <meta property="og:description" content="Comercializadora especializada en los sectores de transformación, refrigeración, automatización y conectividad." />

        <meta property="og:image" content="https://koonolmex.com.mx/logo.png" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:url" content="https://koonolmex.com.mx/" />
        <meta name="twitter:title" content="KoonolMX"/>
        <meta name="twitter:description" content="Comercializadora especializada en los sectores de transformación, refrigeración, automatización y conectividad." />
        <meta name="twitter:image" content="https://koonolmex.com.mx/logo.png" />


        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/png" href="icon.png" />
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
        <title>{title}</title>
        <!-- ES PARA ICONOS-->
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"/>
    </head>

    <body class="bg-[#F6FCFE] font-poppins antialiased min-h-screen flex flex-col">
        <slot />
    </body>
</html>

<style is:global>
    @import "tailwindcss";

    @theme {
        --font-poppins: "Poppins", sans-serif;
        --color-principal: #005671;
        --color-textos: #737373;
    }
</style>