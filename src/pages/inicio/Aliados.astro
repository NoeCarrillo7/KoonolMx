---
import mapa from "../../assets/inicio/aliados/mapa.png";
import teltonika from "../../assets/inicio/aliados/teltonika.png";
import circulo from "../../assets/inicio/aliados/circulo.png";
import recuadros from "../../assets/inicio/aliados/recuadros.png";
---

<section class="w-full py-24 overflow-hidden">
     <!-- Circulo Centro izquierda-->
    <img
        src={circulo.src}
        alt=""
        class="absolute top-1190 right-150 w-80 pointer-events-none"
    />
    <!-- Recuadros izquierda-->
    <img
        src={recuadros.src}
        alt=""
        class="absolute top-1220  left-0 w-20 pointer-events-none"
    />
  <div class="relative w-5/6 mx-auto h-[500px]">

    <!-- Texto -->
    <div class="absolute top-0 left-0 z-20 w-full lg:w-[38%]">
      <h2 class="text-4xl font-medium text-principal mb-5">
        Aliados tecnológicos
      </h2>

      <p class="text-textos text-lg leading-relaxed text-justify">
        Trabajamos con fabricantes líderes a nivel mundial para ofrecer
        soluciones industriales confiables. Porque la confiabilidad no se
        presume; se respalda con conocimiento desde la fuente.
      </p>
    </div>

    <!-- Mapa -->
    <img
      src={mapa.src}
      alt="Mapa Europa"
      class="absolute top-1/2 right-[-10%] -translate-y-1/2 w-[70%] max-w-none object-contain select-none pointer-events-none"
    />

    <!-- Logo Teltonika -->
    <img
      src={teltonika.src}
      alt="Teltonika"
      class="absolute top-1/2 left-[45%] -translate-x-1/2 -translate-y-1/2 w-[45%] z-30"
    />
  </div>
</section>